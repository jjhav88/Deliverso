# APP
NEXT_PUBLIC_APP_URL=

# DATABASE
# Runtime (Prisma Client): pooled URL, e.g. Supabase transaction/session pooler.
DATABASE_URL=

# Prisma CLI + migrations: direct Postgres connection, not the pooler.
DIRECT_URL=

# Optional. Dedicated empty database for `prisma migrate dev` only.
# Never point this at production.
SHADOW_DATABASE_URL=

# AUTH
AUTH_SECRET=

# SUPABASE AUTH (browser-safe publishable values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# STRIPE — TEST MODE only during development.
# Never put the secret key in NEXT_PUBLIC_*.
# LIVE keys (sk_live_ / pk_live_) are rejected in development.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SUPABASE
# Server-only URL alias. Prefer NEXT_PUBLIC_SUPABASE_URL for Auth clients.
SUPABASE_URL=
# Never expose. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# EMAIL — transactional outbox. Never prefix secrets with NEXT_PUBLIC_.
# DEV starts in sandbox. Do not set EMAIL_MODE=enabled outside production.
RESEND_API_KEY=
EMAIL_MODE=sandbox
EMAIL_FROM_NAME=DELIVERSO
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SANDBOX_RECIPIENT=
INTERNAL_CRON_SECRET=
# Vercel Cron alias. Either secret authorizes /api/internal/*.
CRON_SECRET=

# EXCHANGE RATES
# Display FX only. Never a payment authority.
EXCHANGE_RATE_PROVIDER=frankfurter_ecb
EXCHANGE_RATE_API_BASE=https://api.frankfurter.dev
# EXCHANGE_RATE_API_KEY=

# E2E — optional. Never commit real passwords.
# PLAYWRIGHT_BASE_URL=http://localhost:3010
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
